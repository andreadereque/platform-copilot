# PostgreSQL with pgvector
DATABASE_URL=postgresql://localhost/platform_copilot

# LLM provider: ollama (default, free, local) | claude (optional, needs a key)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# Only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Agent limits
MAX_STEPS=5
